# Atavism — Environment Configuration
# Copy this file to .env and fill in values as needed.
# NOTE: .env is gitignored and will never be committed to source control.

# ==============================================================================
# Model Provider Credentials (Used ONLY when running model evaluation trials)
# ==============================================================================

# OpenRouter Configuration (Primary provider for zero-cost free-tier models)
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Frontier Provider Placeholders (For future authorized evaluation phases)
# FRONTIER_API_KEY=
# FRONTIER_BASE_URL=
# FRONTIER_MODEL=

# ==============================================================================
# Evaluation & Security Configuration
# ==============================================================================
# Default trial parameters
ATAVISM_DEFAULT_TRIALS=1
ATAVISM_TIMEOUT=60
ATAVISM_TEMPERATURE=0.0
ATAVISM_MAX_TOKENS=4096

# Execution Security:
# Untrusted model-generated code requires an active Linux container runtime (Docker/Podman).
# Under Windows, untrusted evaluation fails closed with code 126 unless a Linux container host is active.
ATAVISM_TRUST_LEVEL=untrusted
